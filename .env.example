# Observability & Tracing overrides
TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Background sync overrides
CRON_SYNC_ENABLED=false
CRON_SYNC_INTERVAL_MINUTES=60

# Maximum simultaneous background indexing tasks
INDEXING_CONCURRENCY=3

# Host directory mounted at /codebases in Docker
CODEBASES_PATH=.
